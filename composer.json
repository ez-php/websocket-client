{
  "name": "ez-php/websocket-client",
  "version": "2.4.11",
  "description": "RFC 6455 WebSocket client for ez-php — HTTP upgrade handshake, masked frame encoder, plain-TCP and TLS (wss://) transports.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["websocket", "websocket-client", "rfc6455", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/websocket-client",
  "support": {
    "issues": "https://github.com/ez-php/websocket-client/issues",
    "source": "https://github.com/ez-php/websocket-client"
  },
  "require": {
    "php": "^8.5",
    "ext-openssl": "*",
    "ez-php/websocket": "^2.0"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\WebsocketClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
